# Preferred provider-neutral configuration for any OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5-mini
LLM_PROVIDER=openai-compatible

# Backward-compatible aliases. Used only when the corresponding LLM_* value is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Deterministic demo execution is automatic in dev/test. In production it is
# denied (runs fail closed with PROVIDER_AUTH_FAILED) unless enabled here.
LLM_ALLOW_DEMO=

# Optional Python executable override
# 可选：指定 Python 可执行文件
PYTHON_BIN=python3

# Optional: absolute path to the skills directory (standalone/container deploys
# where the repo checkout is not the working directory). Defaults to resolving
# the repository `skills/` folder relative to the runtime module.
# SKILLS_DIR=

# Optional: cap for the in-memory RunStore (default 1000). Oldest runs are
# evicted beyond this limit; replays of evicted idempotency keys create new runs.
# RUN_STORE_MAX_RUNS=1000

# Optional: set to "off" to disable structured lifecycle event logging.
# LOG_EVENTS=on
