# Preferred provider-neutral configuration for any OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5-mini
LLM_PROVIDER=openai-compatible

# Backward-compatible aliases. Used only when the corresponding LLM_* value is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Without an API key, reviewed LLM skills use their deterministic demo adapters.
