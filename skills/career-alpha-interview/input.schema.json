{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interview Risk Map Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_role", "resume"],
  "properties": {
    "target_role": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160,
      "pattern": "\\S",
      "title": "Target role"
    },
    "resume": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30000,
      "pattern": "\\S",
      "title": "Resume / experience"
    },
    "evidence": {
      "type": "string",
      "maxLength": 30000,
      "title": "Evidence / Claim–Evidence Ledger",
      "description": "Optional supplied evidence or serialized ledger. Links and assertions are not independently verified by this Skill."
    }
  }
}
