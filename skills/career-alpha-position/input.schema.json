{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Career Positioning Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_role", "current_material"],
  "properties": {
    "target_role": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160,
      "title": "Target role"
    },
    "current_material": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30000,
      "title": "Current resume / evidence",
      "description": "Paste current bullets, projects, experience, or a Claim–Evidence Ledger."
    },
    "job_description": {
      "type": "string",
      "maxLength": 30000,
      "title": "Job description",
      "description": "Optional JD or target-company context."
    },
    "channel": {
      "type": "string",
      "enum": ["resume", "hr", "founder", "linkedin", "portfolio", "interview"],
      "default": "resume",
      "title": "Primary channel"
    }
  }
}
