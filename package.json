    "skill:validate": "node scripts/skills.mjs validate",
    "skill:init": "node scripts/skills.mjs init"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "next": "16.3.4",
    "openai": "5.19.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
