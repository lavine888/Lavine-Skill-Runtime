{
  "name": "lavine-skill-runtime",
  "version": "0.3.1",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "evals": "vitest run tests/evals.test.ts",
    "typecheck": "tsc --noEmit",
